            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "caaparser",
        "caa record",
        "dns caa",
        "certificate authority authorization",
        "caa parser",
        "dns parser"
    ],
    "homepage": "https://apiverve.com/marketplace/caaparser?utm_source=php&utm_medium=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/caaparser",
        "source": "https://github.com/apiverve/caaparser-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Caaparser\\": "php/src/"
        }
    },
    "autoload-dev": {
